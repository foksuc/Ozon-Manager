# Ozon Seller API credentials — fill locally, never commit real values.
OZON_CLIENT_ID=
OZON_API_KEY=

# API transport
OZON_BASE_URL=https://api-seller.ozon.ru
OZON_TIMEOUT=20

# Local application data
OZON_DB_PATH=data/ozon_manager.sqlite3

# Application mutation batching; this is NOT an asserted Ozon API limit.
OZON_BATCH_SIZE=100

# Application-level Product Info lookup batching. This is not an asserted Ozon API limit.
OZON_PRODUCT_INFO_BATCH_SIZE=1000

# Safe local development mode: 1 = mock adapter, 0 = real adapter.

# Optional partial OzonAPI SDK read integration.
# 1 = use SDK for confirmed read-only /v1/actions and product-name lookup.
# 0 = use the direct adapter for those reads.
OZON_USE_SDK=0

# Application-level read-only reconciliation after ADD mutation.
# These settings control READ retries only; mutation is never retried automatically.
OZON_ADD_RECONCILIATION_READ_ATTEMPTS=3
OZON_ADD_RECONCILIATION_READ_DELAY_SECONDS=1.0
