# Environment / credentials
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python virtual environments
.venv/
venv/
env/

# Python caches / bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Application runtime data
# The application stores its local SQLite database under data/ by default.
data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Application logs / runtime files
logs/
*.log
*.tmp
*.temp
*.swp
*.swo

# Local caches
.cache/
.streamlit/cache/

# Build / packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# IDE / editor files
.vscode/
.idea/
*.code-workspace

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Local environment / tooling files
pip-wheel-metadata/
.python-version
